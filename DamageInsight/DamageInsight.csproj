<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DamageInsight</AssemblyName>
    <RootNamespace>DamageInsight</RootNamespace>
    <Product>SkulInsight QoL</Product>
    <Description>Real damage numbers, a combat log with per-hit calculations and build planning for Skul: The Hero Slayer.</Description>
    <Authors>DocRun</Authors>
    <Version>0.10.1</Version>
    <BepInExPluginGuid>docrun.skulinsight_qol</BepInExPluginGuid>
  </PropertyGroup>

  <!-- Developer tools (dev menu, test room, gear scan, diagnostics) only exist in Debug builds. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Tools\Dev\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DamageInsight.Tests" />
    <!-- Hand-written Codex texts (our own content). -->
    <EmbeddedResource Include="Codex\codex_content.json" LogicalName="DamageInsight.Codex.codex_content.json" />
    <!-- WithCulture=false: "codex_content.ko.json" would otherwise go into a Korean satellite assembly. -->
    <EmbeddedResource Include="Codex\codex_content.*.json" LogicalName="DamageInsight.Codex.%(Filename).json" WithCulture="false" />
    <!-- Translations of the mod's texts, one file per language (English is the key). -->
    <EmbeddedResource Include="Lang\*.json" Exclude="Lang\template.json" LogicalName="DamageInsight.Lang.%(Filename).json" WithCulture="false" />
  </ItemGroup>

</Project>
